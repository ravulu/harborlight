# Supabase Postgres — Project Settings -> Database -> Connection string -> URI.
# Use the "Session pooler" string (port 5432): it works for both drizzle-kit
# migrations and the app at runtime. No sslmode param: TLS is configured in
# lib/db/ssl.ts, which pins Supabase's root CA and verifies the chain in full.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Signs session cookies. Generate your own and keep it out of git.
BETTER_AUTH_SECRET=<run: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))">
BETTER_AUTH_URL=http://localhost:3000

# Where a household's figures are kept: local | cloud.
#
# UNSET MEANS LOCAL, and that is the safe direction — a deployment that forgets
# this stores nothing on the server rather than quietly storing everyone's
# balances. Only the exact string "cloud" turns the database on; "Cloud", "db"
# and a misspelling all mean local.
#
# local: plans, household and the register live in the reader's own browser.
#        There are no accounts — /sign-in and /sign-up are not part of the app.
# cloud: Postgres, per account, as before.
#
# Read at BUILD time, not run time. Changing it needs a rebuild and a redeploy;
# restarting with a different value does nothing at all, which was measured
# rather than assumed. See docs/persistence-modes.md.
#
# Note that local mode still needs DATABASE_URL: analytics and feedback are
# server-side either way. "Local" means no financial data on the server, not
# no database.
NEXT_PUBLIC_PERSISTENCE=local

# Who may open /admin. Comma-separated, case-insensitive, matched against the
# signed-in account's email. Empty or unset means nobody: a deployment that
# forgets this locks admins out rather than letting anyone in, and /admin
# answers 404 to everyone else so its existence is never confirmed.
ADMIN_EMAILS=you@example.com

# The public origin, used for canonical links, the sitemap, and share cards.
# A wrong value points every canonical at a host that does not serve the page,
# which is worse than having none. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Visits from these addresses are not recorded. Yours, so that testing the app
# does not become most of the funnel. Comma-separated; unset means nothing is
# excluded by address. Whoever is in ADMIN_EMAILS is excluded already, by
# account, whatever address they are on.
#
# Find yours with: curl -s https://api.ipify.org
#
# Only has an effect in production. A request to a local dev server carries no
# x-forwarded-for header — that is set by a proxy, and locally there is none —
# so nothing local can be matched by address. Development is not recorded at
# all for that reason.
ANALYTICS_EXCLUDE_IPS=

# Record events while running locally. Only wanted when working on the
# tracking itself; leave it unset otherwise.
ANALYTICS_IN_DEV=
